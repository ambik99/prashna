---
// Three stacked cards, the top one showing a line of a Question or Template.
import { bars, ui } from "../ui.ts";

interface Props {
  meta: [string, string];
  text: string;
}
const { meta, text } = Astro.props;
const layer = `${ui} absolute inset-0 px-14 py-12 text-left`;
---

<div class="relative w-210 h-112" aria-hidden="true">
  <div class:list={[layer, "[transform:rotate(-6deg)_translate(-12px,14px)] opacity-70"]}></div>
  <div class:list={[layer, "[transform:rotate(-3deg)_translate(-6px,7px)] opacity-85"]}></div>
  <div class:list={[layer, "[transform:rotate(1.5deg)]"]}>
    <div class="flex justify-between text-[10px] text-muted"><span>{meta[0]}</span><span>{meta[1]}</span></div>
    <p class="mt-6 font-display text-[13px] leading-[1.3] font-[500]">{text}</p>
    <div class={bars}><i></i><i></i></div>
  </div>
</div>
