---
import CardStack from "./CardStack.astro";
import FeatureCard from "./FeatureCard.astro";
import { bars, chip, contentWidth, reveal, sectionHead, sectionSub, sectionTitle, ui } from "../ui.ts";

const key =
  "grid place-items-center w-50 h-50 rounded-[12px] bg-raised shadow-[var(--landing-shadow-chip),0_6px_14px_-8px_rgba(0,0,0,0.25)] font-display text-[24px] font-[500]";
const device = `${ui} grid place-items-center gap-6 w-72 h-76 pt-6 text-[11px] font-[500] [&_svg]:w-22 [&_svg]:h-22`;
const raisedShadow = "shadow-[var(--landing-shadow-chip),0_10px_24px_-12px_rgba(0,0,0,0.3)]";
const division = `${ui} grid gap-2 justify-items-center w-70 py-10 text-[11px] text-muted [&_b]:text-[16px] [&_b]:text-fg [&_b]:font-[600]`;
const orLine = `${ui} w-full px-12 py-8 font-display text-[12px] text-left`;
---

<section class:list={[contentWidth, "pt-160 max-sm:pt-112"]} id="features" aria-labelledby="features-title">
  <div class={sectionHead}>
    <h2 id="features-title" class:list={[sectionTitle, reveal]}>Everything a CBSE Paper needs, in one place.</h2>
    <p class:list={[sectionSub, reveal]} style="--delay:.05s">
      Design the Paper, write its Marking Scheme and print it, the way CBSE Papers are set. Free and private by default.
    </p>
  </div>
  <div class="mt-56 grid grid-cols-3 max-md:grid-cols-2 max-sm:grid-cols-1 gap-8">
    <FeatureCard title="Sections A to E">
      <div slot="art" class="flex gap-8" aria-hidden="true">
        {["A", "B", "C", "D", "E"].map((letter) => <span class={key}>{letter}</span>)}
      </div>
      Each Section keeps its own marks per Question and its own count.
    </FeatureCard>
    <FeatureCard title="CBSE question types" delay=".06s">
      <CardStack slot="art" meta={["Section A · MCQ", "[1 Mark]"]} text="Which of the following is an amphoteric oxide?" />
      Standard, MCQ, Assertion–Reason and Case-Study.
    </FeatureCard>
    <FeatureCard title="Marks blueprint" delay=".12s">
      <div slot="art" class="flex flex-wrap justify-center gap-6 max-w-[250px]" aria-hidden="true">
        <span class={chip}>Section A <b>20M</b></span>
        <span class={chip}>Section B <b>10M</b></span>
        <span class={chip}>Section C <b>18M</b></span>
        <span class:list={[chip, "bg-chip-total!"]}>Total <b>80</b></span>
        <span class:list={[chip, "bg-chip-left!"]}>8 marks remaining</span>
      </div>
      Every Section counted against your Target Marks as you type.
    </FeatureCard>

    <FeatureCard title="Internal choices">
      <div slot="art" class="grid gap-6 justify-items-center w-220" aria-hidden="true">
        <div class={orLine}>5. What are homologous series? Explain with two examples.</div>
        <span class="font-display text-[12px] font-[600] tracking-[0.2em] text-muted">OR</span>
        <div class={orLine}>Explain esterification and saponification.</div>
      </div>
      Add an “OR” Alternative Question to any Question.
    </FeatureCard>
    <FeatureCard title="On any device" delay=".06s">
      <div slot="art" class="flex gap-10" aria-hidden="true">
        <span class={device}><svg><use href="#i-android"></use></svg>Android</span>
        <span class={device}><svg><use href="#i-phone"></use></svg>iPhone</span>
        <span class={device}><svg><use href="#i-laptop"></use></svg>Computer</span>
      </div>
      Get the App on Android, iPhone or a computer, or use it in the browser.
    </FeatureCard>
    <FeatureCard title="Question Bank" delay=".12s">
      <div slot="art" class:list={[ui, "w-230 px-12 py-10 text-left"]} aria-hidden="true">
        <div class="flex items-center gap-8 text-[13px]">
          <svg class="w-14 h-14 opacity-60"><use href="#i-search"></use></svg>Ohm’s law<kbd
            class="ml-auto font-[inherit] text-[10px] text-muted">Bank</kbd
          >
        </div>
        <div class="mt-8 px-8 py-6 rounded-[6px] bg-tint-3 text-[11px] text-muted [&_b]:text-fg [&_b]:font-[500]">
          <b>Standard · 3 Marks</b> · State Ohm’s law and draw…
        </div>
      </div>
      Save your Questions once, search them and insert them into any Paper.
    </FeatureCard>

    <FeatureCard title="Hindi and Bengali">
      <div slot="art" class="grid gap-8 justify-items-center" aria-hidden="true">
        <span class:list={[ui, "px-14 py-8 text-[13px]"]}>prashna</span>
        <svg class="w-14 h-14 opacity-50"><use href="#i-swap"></use></svg>
        <span class:list={[ui, "px-14 py-8 text-[18px]"]}>प्रश्न · প্রশ্ন</span>
      </div>
      Type phonetically in English letters and insert Devanagari or Bengali.
    </FeatureCard>
    <FeatureCard title="Marking Scheme" delay=".06s">
      <div
        slot="art"
        class:list={["relative w-132 h-160 p-12 rounded-[4px] bg-white [transform:rotate(-3deg)]", raisedShadow]}
        aria-hidden="true"
      >
        <h4 class="font-display text-[9px] text-center tracking-[0.04em]">MARKING SCHEME</h4>
        <div class:list={[bars, "mt-10! [&>i]:h-4!"]}><i></i><i></i><i></i><i></i><i></i></div>
        <span
          class="absolute -right-22 top-62 px-10 py-5 rounded-[999px] bg-fg text-on-fg text-[11px] font-[500] [transform:rotate(3deg)] shadow-float"
          >(b) Al₂O₃</span
        >
      </div>
      Write each answer as you add the Question. Show it beside the Paper or print it alone.
    </FeatureCard>
    <FeatureCard title="Science Division" tag="Class 9–10" delay=".12s">
      <div slot="art" class="flex gap-8" aria-hidden="true">
        <span class={division}><b>25</b>Physics</span>
        <span class={division}><b>25</b>Chemistry</span>
        <span class={division}><b>30</b>Biology</span>
      </div>
      Balance a combined Science Paper across Physics, Chemistry and Biology.
    </FeatureCard>

    <FeatureCard title="Ready-made Templates">
      <CardStack slot="art" meta={["Template", "80 Marks"]} text="Board Pattern Starter (Class X)" />
      Start from a Unit Test, Half-Yearly or Board pattern and make it yours.
    </FeatureCard>
    <FeatureCard title="Export to Word" delay=".06s">
      <div slot="art" class="relative" aria-hidden="true">
        <div class:list={["w-104 h-128 px-12 py-14 rounded-[6px] bg-raised", raisedShadow]}>
          <div class={bars}><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <span class="absolute -left-14 bottom-16 px-9 py-4 rounded-[5px] bg-word text-white text-[11px] font-[600] shadow-float">W .doc</span>
      </div>
      Take the Paper into Word for last changes in your own document.
    </FeatureCard>
    <FeatureCard title="Works offline" delay=".12s">
      <div slot="art" class="grid gap-8 justify-items-center" aria-hidden="true">
        <span
          class="relative w-64 h-48 rounded-[4px_8px_8px_8px] bg-[linear-gradient(#5fb4f2,#3a95e0)] shadow-[0_6px_14px_-8px_rgba(30,90,160,0.6)] before:absolute before:left-0 before:-top-7 before:w-26 before:h-10 before:rounded-[4px_4px_0_0] before:bg-[#4aa3ea]"
        ></span>
        <span class={chip}>On this device</span>
      </div>
      Once opened, Prashna works without internet and saves as you type.
    </FeatureCard>
  </div>
</section>
