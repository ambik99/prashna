---
import { contentWidth, reveal, sectionSub, sectionTitle } from "../ui.ts";

const pill = "px-12 py-5 rounded-[999px] bg-tint-5 text-[14px] font-[500] text-fg-90";
const phone =
  "absolute w-[26%] aspect-[390/844] p-7 max-sm:p-4 rounded-[34px] max-sm:rounded-[22px] bg-frame shadow-[0_20px_50px_-18px_rgba(0,0,0,0.55)]";
const phoneImg = "w-full h-full object-cover object-top rounded-[27px] max-sm:rounded-[18px] bg-white";
---

<section class:list={[contentWidth, "pt-140"]} id="devices" aria-labelledby="privacy-title">
  <div class:list={[reveal, "rounded-[16px] bg-tint-4 overflow-hidden pt-80 px-24 text-center"]}>
    <h2 id="privacy-title" class:list={[sectionTitle, "mx-auto"]}>Your papers stay on your device.</h2>
    <p class:list={[sectionSub, "mx-auto max-w-[420px]!"]}>
      AI requests are sent only when you ask for one. Your Papers and Question Bank are kept in the browser on your phone
      or computer. To move a Paper, save it as a file. No account required.
    </p>
    <div class="mt-24 flex flex-wrap justify-center gap-8">
      <span class={pill}>Free</span><span class={pill}>No sign-up</span><span class={pill}>Works offline</span>
    </div>
    <div class="relative mt-64 max-sm:mt-40 mx-auto w-[min(760px,100%)] h-400 max-md:h-300 max-sm:h-220" aria-hidden="true">
      <div
        class="absolute left-1/2 -bottom-40 w-[92%] [translate:-50%_0] pt-12 px-12 rounded-[18px_18px_0_0] bg-frame shadow-[0_20px_50px_-18px_rgba(0,0,0,0.5)]"
      >
        <img class="rounded-[6px_6px_0_0]" src="images/app-desktop-1280.webp" width="1280" height="800" alt="" loading="lazy" />
      </div>
      <div class:list={[phone, "left-[2%] -bottom-60"]}>
        <img class={phoneImg} src="images/phone-edit-390.webp" width="390" height="844" alt="" loading="lazy" />
      </div>
      <div class:list={[phone, "right-[2%] -bottom-110"]}>
        <img class={phoneImg} src="images/phone-preview-390.webp" width="390" height="844" alt="" loading="lazy" />
      </div>
    </div>
  </div>
</section>
