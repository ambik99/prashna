---
const LINKS = [
  {
    title: "Product",
    links: [
      ["Open the app", "app/"],
      ["Features", "#features"],
      ["Print & Word", "#output"],
    ],
  },
  {
    title: "Learn",
    links: [
      ["How it works", "#top"],
      ["FAQ", "#faq"],
      ["Privacy", "#devices"],
    ],
  },
];
const item = "text-[13px] text-muted transition-colors duration-150 ease-[ease-out]";
const list = "mt-16 grid gap-12";
const heading = "text-[13px] font-[500]";
---

<footer class="mx-auto w-[min(896px,calc(100%-48px))] max-sm:w-[calc(100%-32px)] pb-32">
  <div
    class="grid grid-cols-[1.6fr_repeat(3,1fr)] max-md:grid-cols-2 max-sm:grid-cols-1 gap-32 max-sm:gap-28 py-48 border-y border-tint-5"
  >
    <div>
      <a class="inline-flex items-center gap-6 font-[600]" href="#top"
        ><img class="w-18 h-18 rounded-[5px]" src="app/icon-192.png" alt="" />Prashna</a
      >
      <p class="mt-12 max-w-[220px] text-[13px] leading-[20px] text-muted">
        Question papers for CBSE teachers. Free, offline, on your own device.
      </p>
    </div>
    {
      LINKS.map(({ title, links }) => (
        <nav aria-label={title}>
          <h2 class={heading}>{title}</h2>
          <ul class={list}>
            {links.map(([label, href]) => (
              <li class={item}>
                <a class:list={[item, "hover:text-fg"]} href={href}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <nav aria-label="About">
      <h2 class={heading}>About</h2>
      <ul class={list}>
        <li class={item}><a class:list={[item, "hover:text-fg"]} href="#maker">Made by a teacher</a></li>
        <li class={item}>
          Contact: <span
            class="px-6 py-1 border border-dashed border-placeholder-border rounded-[5px] bg-placeholder text-on-placeholder text-[13px] font-[500]"
            >Placeholder: contact email</span
          >
        </li>
      </ul>
    </nav>
  </div>
  <div class="pt-24 flex flex-wrap justify-center gap-16 text-[12px] text-muted">
    <span>© 2026 Prashna</span><span>Prashna is made by a teacher and is not affiliated with CBSE.</span>
  </div>
</footer>
