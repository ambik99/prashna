---
// The Landing Page at the site root. It shares the app's theme, Get the App,
// fonts, tokens and icons, loaded from app/ (every path is relative, so the
// page also works from the beta site's sub-folder).
import "../styles.css";
import Closing from "../components/Closing.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Formats from "../components/Formats.astro";
import Hero from "../components/Hero.astro";
import Icons from "../components/Icons.astro";
import Launch from "../components/Launch.astro";
import Maker from "../components/Maker.astro";
import Nav from "../components/Nav.astro";
import Output from "../components/Output.astro";
import Privacy from "../components/Privacy.astro";
import Tour from "../components/Tour.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Prashna: question papers for CBSE teachers</title>
    <meta
      name="description"
      content="Prashna helps CBSE teachers design question papers and marking schemes, then print or export to Word. Free, works offline, no sign-up."
    />
    <meta name="theme-color" content="#f8f8f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="app/theme.js"></script>
    <link rel="manifest" href="app/manifest.json" />
    <link rel="icon" type="image/png" sizes="32x32" href="app/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="app/icon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="app/apple-touch-icon.png" />
    <link rel="preload" href="app/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="app/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="app/fonts.css" />
    <link rel="stylesheet" href="app/tokens.css" />
    <link rel="stylesheet" href="app/get-app.css" />
    <link rel="stylesheet" href="app/theme-toggle.css" />
    <script is:inline>
      document.documentElement.classList.add("js");
      // Launch animation: once per browser session, never under reduced
      // motion. Decided before the first paint so the page never flashes.
      try {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !sessionStorage.getItem("prashna-launched")) {
          sessionStorage.setItem("prashna-launched", "1");
          document.documentElement.classList.add("launching");
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <Icons />
    <Launch />
    <Nav />
    <main id="top">
      <Hero />
      <Tour />
      <Features />
      <Output />
      <Formats />
      <Privacy />
      <Maker />
      <Closing />
    </main>
    <Footer />

    <script is:inline src="app/get-app.js"></script>
    <script>
      import "../landing.ts";
    </script>
  </body>
</html>
