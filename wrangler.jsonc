// Cloudflare serves the built site in dist/ (put together by
// `npm run build`, see scripts/assemble.mjs). Folder URLs open their
// index.html, and /app/index.html redirects to /app/ (sw.js handles that
// redirect). Only /api/* runs the Worker (worker/src/index.ts). Every pull
// request gets a preview link.
{
  "name": "prashna",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  // Wrangler runs this before `deploy`, `preview` and `dev`.
  "build": {
    "command": "npm run build",
    "watch_dir": ["apps/app/src", "apps/app/public", "apps/landing/src", "apps/landing/public", "packages/paper/src"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Counts AI requests and spending for the cost controls (worker/src/limits.ts).
  "durable_objects": {
    "bindings": [{ "name": "LIMITS", "class_name": "LimitsObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LimitsObject"] }],
  // Secrets, set with `wrangler secret put`: GEMINI_API_KEY and
  // TURNSTILE_SECRET_KEY (see docs/hosting.md).
  //
  // TURNSTILE_HOSTNAMES: the hostnames a Turnstile token may come from,
  // comma-separated. The Worker refuses tokens solved anywhere else. Never
  // add localhost here; local development uses .dev.vars.
  "vars": {
    "TURNSTILE_HOSTNAMES": "prashna.ambik99.workers.dev"
  },
  //
  // Needed by `wrangler preview`, which Cloudflare runs for pull requests.
  // Each preview gets its own, empty LimitsObject.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "LIMITS", "class_name": "LimitsObject" }]
    }
  }
}
